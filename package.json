{
  "name": "rgo-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generative Strudel music library and lightweight 24/7 YouTube stream.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/build-strudel.js",
    "compose": "node src/cli/compose.js",
    "render": "node src/cli/render.js",
    "calibrate": "node src/cli/calibrate.js",
    "analyze": "node src/cli/analyze.js",
    "library": "node src/cli/library.js",
    "stream": "node src/stream/main.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "esbuild": "0.28.2",
    "node-web-audio-api": "2.2.0",
    "superdough": "1.3.0"
  }
}
