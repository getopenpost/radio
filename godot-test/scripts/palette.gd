# Golden hour overlays a warm tint on a few slots (sparse, like palette.js).
static var GOLDEN := {
    "sky0": Color("#e6d3bf"),
    "sky1": Color("#efc9a3"),
    "sky2": Color("#f1a96b"),
    "cloud": Color("#f3c79c"),
    "cloudShade": Color("#d39a72"),
    "far0": Color("#d6b394"),
    "far1": Color("#c49c7d"),
    "sun": Color("#e8692a"),
}

static func idx(name: String) -> int:
    return NAMES.find(name)

static func color_of(pal: PackedColorArray, name: String) -> Color:
    return pal[idx(name)]

# night_t: 0 day .. 1 night. warm_t: golden-hour strength, 0..1.
static func compute(night_t: float, warm_t: float) -> PackedColorArray:
    var out := PackedColorArray()
    out.resize(DAY.size())
    for i in DAY.size():
        out[i] = DAY[i].lerp(NIGHT[i], night_t)
    if warm_t > 0.001:
        for k in GOLDEN:
            var i := idx(k)
            if i >= 0:
                out[i] = out[i].lerp(GOLDEN[k], warm_t)
    return out
